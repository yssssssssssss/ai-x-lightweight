{
  "name": "ai-x-lightweight",
  "version": "0.1.0",
  "private": true,
  "description": "原生 Skill 编排、材料输入与确定性报告运行时",
  "type": "module",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:migrate": "tsx database/run-migrations.ts",
    "db:seed": "tsx database/run-seed.ts",
    "lint:registry": "tsx harness/linters/registry-linter.ts",
    "lint:knowledge": "tsx harness/linters/knowledge-linter.ts",
    "kb:import": "tsx scripts/kb-import.ts",
    "kb:build": "tsx apps/orchestrator-runtime/src/knowledge/build.ts",
    "hub:integration": "tsx scripts/user-research-hub-integration.ts",
    "playwright:install:chromium": "playwright install chromium",
    "spike:plan": "tsx apps/orchestrator-runtime/src/spike-plan.ts",
    "spike:execute": "tsx apps/orchestrator-runtime/src/spike-execute.ts",
    "gold:run": "tsx apps/orchestrator-runtime/src/gold-run.ts",
    "editorial:report": "tsx apps/orchestrator-runtime/src/editorial-report.ts",
    "api:dev": "tsx watch apps/agent-api/src/server.ts",
    "cutover:prepare": "tsx apps/orchestrator-runtime/src/cutover/cutover-cli.ts prepare",
    "cutover:verify": "tsx apps/orchestrator-runtime/src/cutover/cutover-cli.ts verify",
    "cutover:rehearse": "tsx apps/orchestrator-runtime/src/cutover/cutover-cli.ts rehearse",
    "cutover:verify-rehearsal": "tsx apps/orchestrator-runtime/src/cutover/cutover-cli.ts verify-rehearsal",
    "dev:stack": "tsx scripts/dev-stack.ts",
    "smoke:current:real": "tsx scripts/current-real-smoke.ts",
    "labs:install": "for d in external-tools/*-lab; do (echo \"npm install @ $d\" && cd \"$d\" && npm install); done",
    "labs:dev": "node scripts/start-labs.mjs",
    "eval:skills": "tsx evaluations/skills/run.ts",
    "eval:skills:kb": "tsx evaluations/skills/run.ts",
    "eval:skills:kb:compare": "tsx evaluations/skills/kb/compare.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "build:api": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:web": "pnpm --dir apps/web build",
    "build": "pnpm build:api && pnpm build:web",
    "migrate:prod": "node dist/database/run-migrations.js",
    "start": "node dist/apps/agent-api/src/server.js",
    "quality": "pnpm typecheck && pnpm lint:registry && pnpm lint:knowledge && pnpm test",
    "editorial:showcase": "tsx apps/orchestrator-runtime/src/universal-editorial-report.ts",
    "editorial:showcase:offline": "tsx apps/orchestrator-runtime/src/universal-editorial-showcase.ts"
  },
  "dependencies": {
    "@openclaw/fs-safe": "0.5.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "csv-parse": "^7.0.2",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "playwright": "1.60.0",
    "sharp": "^0.35.3",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
